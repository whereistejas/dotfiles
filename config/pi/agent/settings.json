{
  "lastChangelogVersion": "1.5.2",
  "theme": "gruvbox-light",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "anthropic/claude-opus-5-5:high",
    "anthropic/claude-sonnet-5:high"
  ],
  "packages": [
    "git:github.com/mvzink/jj-hunk-tool",
    "npm:@ff-labs/pi-fff",
    "npm:@earendil-works/pi-voice"
  ],
  "extensions": [
    "~/build/dotfiles/plugins/pi-branch",
    "~/build/dotfiles/plugins/pi-nvim-terminal",
    "~/build/dotfiles/plugins/pi-window-title",
    "~/build/dotfiles/plugins/pi-minimal-footer",
    "~/build/dotfiles/plugins/pi-mention"
  ],
  "quietStartup": true,
  "tuiMode": "regular",
  "hideThinkingBlock": false,
  "warnings": {
    "anthropicExtraUsage": false
