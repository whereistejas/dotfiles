/**
 * web-search extension.
 *
 * Registers a `web_search` tool the LLM can call to search the web. It uses
 * Anthropic's server-side web search tool (`web_search_20250305`) via the
 * Messages API: pi sends the query to Claude with web search enabled, Claude
 * runs the searches, and this tool returns the synthesized answer plus the
 * source URLs it cited.
 *
 * Auth is resolved from the `anthropic` provider (via `/login`, auth.json, or
 * ANTHROPIC_API_KEY), so no extra configuration is needed if you already use
 * Anthropic models in pi.
 *
 * By default the tool returns Claude's synthesized answer plus the source URLs
 * it cited. Pass `raw_results: true` to instead return the raw search hits
 * (title, URL, and page age) grouped by the query Claude issued, with no
 * synthesized summary.
 *
 * Model selection: by default the search runs on whatever model pi is currently
 * using, as long as it's an Anthropic model (web search is an Anthropic
 * server-side tool). If pi's current model is non-Anthropic (or unknown), it
 * falls back to PI_WEB_SEARCH_MODEL / claude-sonnet-4-5.
 *
 * Environment overrides:
 *   PI_WEB_SEARCH_MODEL     force a specific model id for the search (overrides pi's current model)
 *   PI_WEB_SEARCH_MAX_USES  default max number of searches per call (default: 5)
 */

import { Type } from "@earendil-works/pi-ai";
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

const API_URL = "https://api.anthropic.com/v1/messages";
const ANTHROPIC_VERSION = "2023-06-01";
const MODEL_OVERRIDE = process.env.PI_WEB_SEARCH_MODEL;
const FALLBACK_MODEL = "claude-sonnet-4-5";
const DEFAULT_MAX_USES = Number(process.env.PI_WEB_SEARCH_MAX_USES) || 5;
const MAX_PAUSE_CONTINUATIONS = 5;

type Source = { url: string; title?: string };
type SearchResult = { url: string; title?: string; page_age?: string };
type SearchGroup = { query?: string; results: SearchResult[] };

type AnthropicBlock =
	| { type: "text"; text: string; citations?: Array<{ url?: string; title?: string }> }
	| { type: "server_tool_use"; id?: string; name?: string; input?: { query?: string } }
	| {
			type: "web_search_tool_result";
			tool_use_id?: string;
			content?: Array<{ url?: string; title?: string; page_age?: string }>;
	  }
	| { type: string; [key: string]: unknown };

type AnthropicResponse = {
	content?: AnthropicBlock[];
	stop_reason?: string;
	error?: { message?: string };
};

function isOAuthToken(key: string): boolean {
	return key.includes("sk-ant-oat");
}

function buildHeaders(apiKey: string): Record<string, string> {
	const headers: Record<string, string> = {
		"content-type": "application/json",
		"anthropic-version": ANTHROPIC_VERSION,
	};
	if (isOAuthToken(apiKey)) {
		headers.authorization = `Bearer ${apiKey}`;
		headers["anthropic-beta"] = "oauth-2025-04-20";
	} else {
		headers["x-api-key"] = apiKey;
	}
	return headers;
}

function collectSources(blocks: AnthropicBlock[], sources: Map<string, Source>): void {
	for (const block of blocks) {
		if (block.type === "web_search_tool_result" && Array.isArray(block.content)) {
			for (const item of block.content) {
				if (item?.url) sources.set(item.url, { url: item.url, title: item.title });
			}
		}
		if (block.type === "text" && Array.isArray((block as { citations?: unknown }).citations)) {
			for (const c of (block as { citations: Array<{ url?: string; title?: string }> }).citations) {
				if (c?.url) sources.set(c.url, { url: c.url, title: c.title });
			}
		}
	}
}

// Collect the raw search hits, grouped by the query Claude issued. Each
// `web_search_tool_result` block is paired with its originating
// `server_tool_use` block via tool_use_id to recover the query.
function collectResults(
	blocks: AnthropicBlock[],
	queryById: Map<string, string>,
	groups: SearchGroup[],
): void {
	for (const block of blocks) {
		if (block.type === "server_tool_use") {
			const b = block as { id?: string; input?: { query?: string } };
			if (b.id && b.input?.query) queryById.set(b.id, b.input.query);
		}
	}
	for (const block of blocks) {
		if (block.type === "web_search_tool_result" && Array.isArray(block.content)) {
			const toolUseId = (block as { tool_use_id?: string }).tool_use_id;
			const results: SearchResult[] = [];
			for (const item of block.content) {
				if (item?.url) {
					results.push({ url: item.url, title: item.title, page_age: item.page_age });
				}
			}
			if (results.length > 0) {
				groups.push({
					query: toolUseId ? queryById.get(toolUseId) : undefined,
					results,
				});
			}
		}
	}
}

export default function (pi: ExtensionAPI) {
	pi.registerTool({
		name: "web_search",
		label: "Web Search",
		description:
			"Search the web and return an up-to-date answer with source URLs. Use for current " +
			"events, recent releases, documentation, or any question needing information beyond " +
			"the training cutoff. Provide a focused natural-language query or question. " +
			"Set raw_results=true to get the raw list of search hits (title, URL, page age) " +
			"grouped by query instead of a synthesized answer.",
		promptSnippet: "Search the web for current information and return an answer with sources",
		promptGuidelines: [
			"Use web_search when the user asks about current events, recent versions/releases, or anything likely newer than your training data.",
		],
		parameters: Type.Object({
			query: Type.String({ description: "The search query or question to answer." }),
			max_uses: Type.Optional(
				Type.Number({
					description: `Max number of searches Claude may run (default ${DEFAULT_MAX_USES}).`,
				}),
			),
			raw_results: Type.Optional(
				Type.Boolean({
					description:
						"Return the raw search hits (title, URL, page age) grouped by query " +
						"instead of a synthesized answer. Default false.",
				}),
			),
		}),

		async execute(_toolCallId, params, signal, onUpdate, ctx) {
			const apiKey =
				(await ctx.modelRegistry.getApiKeyForProvider("anthropic")) ||
				process.env.ANTHROPIC_API_KEY;
			if (!apiKey) {
				throw new Error(
					"No Anthropic credentials found. Run `/login` for Anthropic or set ANTHROPIC_API_KEY.",
				);
			}

			// Prefer pi's current model when it's an Anthropic model, since web search
			// is an Anthropic server-side tool. An explicit env override always wins.
			const currentModel = ctx.model;
			const currentIsAnthropic =
				currentModel?.provider === "anthropic" ||
				currentModel?.api === "anthropic-messages";
			const model =
				MODEL_OVERRIDE ||
				(currentIsAnthropic && currentModel ? currentModel.id : FALLBACK_MODEL);

			const maxUses =
				typeof params.max_uses === "number" && params.max_uses > 0
					? Math.floor(params.max_uses)
					: DEFAULT_MAX_USES;

			onUpdate?.({ content: [{ type: "text", text: `Searching: ${params.query}` }] });

			const headers = buildHeaders(apiKey);
			const messages: Array<{ role: string; content: unknown }> = [
				{ role: "user", content: params.query },
			];

			const rawResults = params.raw_results === true;
			const sources = new Map<string, Source>();
			const queryById = new Map<string, string>();
			const groups: SearchGroup[] = [];
			let answer = "";

			for (let i = 0; i <= MAX_PAUSE_CONTINUATIONS; i++) {
				const body: Record<string, unknown> = {
					model,
					max_tokens: 4096,
					messages,
					tools: [{ type: "web_search_20250305", name: "web_search", max_uses: maxUses }],
				};
				if (isOAuthToken(apiKey)) {
					body.system = "You are Claude Code, Anthropic's official CLI for Claude.";
				}

				const res = await fetch(API_URL, {
					method: "POST",
					headers,
					body: JSON.stringify(body),
					signal,
				});

				if (!res.ok) {
					const text = await res.text().catch(() => "");
					throw new Error(`Anthropic API error (${res.status}): ${text}`);
				}

				const data = (await res.json()) as AnthropicResponse;
				const blocks = data.content ?? [];

				collectSources(blocks, sources);
				if (rawResults) collectResults(blocks, queryById, groups);
				for (const block of blocks) {
					if (block.type === "text" && typeof (block as { text?: string }).text === "string") {
						answer += (block as { text: string }).text;
					}
				}

				if (data.stop_reason === "pause_turn") {
					messages.push({ role: "assistant", content: blocks });
					continue;
				}
				break;
			}

			const sourceList = [...sources.values()];

			if (rawResults) {
				const allResults = groups.flatMap((g) => g.results);
				let text: string;
				if (groups.length === 0) {
					text = "(no results returned)";
				} else {
					text = groups
						.map((g) => {
							const header = g.query ? `Query: ${g.query}` : "Query: (unknown)";
							const list = g.results
								.map((r, idx) => {
									const age = r.page_age ? ` (${r.page_age})` : "";
									return `${idx + 1}. ${r.title ? `${r.title} — ` : ""}${r.url}${age}`;
								})
								.join("\n");
							return `${header}\n${list}`;
						})
						.join("\n\n");
				}
				return {
					content: [{ type: "text", text }],
					details: { query: params.query, groups, results: allResults },
				};
			}

			let text = answer.trim() || "(no answer returned)";
			if (sourceList.length > 0) {
				text += "\n\nSources:\n";
				text += sourceList
					.map((s, idx) => `${idx + 1}. ${s.title ? `${s.title} — ` : ""}${s.url}`)
					.join("\n");
			}

			return {
				content: [{ type: "text", text }],
				details: { query: params.query, sources: sourceList },
			};
		},
	});
}
